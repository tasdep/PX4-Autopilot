#!/bin/sh
#
# KakuteH7 specific board extras init
#------------------------------------------------------------------------------

if ! param compare OSD_ATXXXX_CFG 0
then
	atxxxx start -s
fi

# Serial DShot telemetry is normally wired to UART7 on this board. Leave it
# disabled for the Kakute H7 BDShot test build so bidirectional DShot telemetry
# is the only ESC feedback path.
# dshot telemetry -d /dev/ttyS5
